# Copy to .env and fill in. Everything else has a default (see desk/config.py).

# ---- Claude (Agent SDK) - same key/login the newsroom uses
ANTHROPIC_API_KEY=
# DESK_MODEL=claude-opus-5-5
# DESK_EFFORT=high

# ---- Safety: keep dry run on until previews look right (data/previews/*.md)
DESK_DRY_RUN=true
# auto = publish at the slot after DESK_HOLD_MINUTES; approve = wait for `desk approve <id>`
DESK_REVIEW_MODE=auto
DESK_HOLD_MINUTES=45
# Slack/Discord webhook: every queued post is previewed here with a cancel command
DESK_NOTIFY_WEBHOOK_URL=

# ---- Rhythm
# DESK_POSTS_PER_WEEK_MIN=2
# DESK_POSTS_PER_WEEK_MAX=4
# DESK_QUIET_WEEK_CHANCE=0.15
# DESK_MIN_GAP_HOURS=20

# ---- Signals: the Nakoda News collector database (read-only) on the same box
DESK_NEWS_DB=/var/lib/nakoda-news-collector/news.db
# Optional: our own news.nakoda.ai stories, to link to
NEWSROOM_API_BASE=http://127.0.0.1:8000
NEWSROOM_TOKEN=

# ---- Images (free keys: pexels.com/api, unsplash.com/developers)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ---- LinkedIn (developer app at linkedin.com/developers)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Company page: urn:li:organization:<page id>  |  personal: urn:li:person:<id from `desk auth whoami`>
LINKEDIN_AUTHOR_URN=
# Company page posting needs the Community Management API product (w_organization_social).
# Personal-only setups can use: openid profile w_member_social
LINKEDIN_SCOPES=openid profile w_member_social w_organization_social
LINKEDIN_API_VERSION=202610
